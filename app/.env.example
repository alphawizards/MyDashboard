# ============================================================
# MyDashboard — Railway Postgres environment template
# Copy to .env.local and fill in real values (never commit .env.local)
# ============================================================

# --- Database (Railway Postgres — auto-injected in Railway, required locally) ---
# Get from: Railway dashboard → Postgres service → Connect → Public URL (local)
# Use the private railway.internal URL when running inside Railway
DATABASE_URL=postgresql://postgres:password@host.railway.internal:5432/railway
DATABASE_PUBLIC_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:PORT/railway

# --- App URL ---
# Set to your Railway public domain or custom domain
NEXT_PUBLIC_SITE_URL=https://genuine-prosperity-production-afe2.up.railway.app

# --- X / Twitter feed (Phase 3) ---
# Bearer token from developer.twitter.com
X_BEARER_TOKEN=

# --- Refresh API security (generate with: openssl rand -hex 32) ---
REFRESH_SHARED_SECRET=

# --- Local-only account creation ---
# Enables the Add Account form and /api/x-accounts POST only outside production,
# and only when REFRESH_SHARED_SECRET is empty. Uses local data/tracked-accounts.json.
LOCAL_ACCOUNT_CREATION_ENABLED=false

# --- Auth (Phase 5) ---
# Comma-separated list of allowed email addresses
AUTH_EMAIL_ALLOWLIST=you@example.com

# --- Optional monitoring (Phase 5+) ---
SENTRY_DSN=
HEARTBEAT_URL=
