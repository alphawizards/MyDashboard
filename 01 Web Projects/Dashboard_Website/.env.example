# RetireAU Dashboard — Environment Variable Template
#
# Copy this file to `.env.local` in your Next.js project root and fill in the values.
# NEVER commit `.env.local` or any file containing real secrets. `.env.local` is in
# Next.js's default `.gitignore` — keep it that way.
#
# Every variable marked REQUIRED must be set for the app to boot. OPTIONAL variables
# have sensible defaults documented inline.

# =============================================================================
# APPLICATION
# =============================================================================

# REQUIRED — Canonical URL of the deployed app. Used by Clerk for OAuth redirects,
# by the Zod API for CORS origin checks, and by Next.js for absolute URL generation.
# Local dev: http://localhost:3000
# Production: https://retire.example.com.au
NEXT_PUBLIC_APP_URL=http://localhost:3000

# REQUIRED — Runtime environment indicator. Controls log verbosity, error reporting,
# and strict mode on Zod schemas. One of: development | staging | production
NODE_ENV=development


# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================
# Get these from https://dashboard.clerk.com → your application → API Keys
# Use the TEST keys for local dev, LIVE keys for production.

# REQUIRED — Clerk publishable key. Safe to expose to the browser.
# Format: pk_test_... (dev) or pk_live_... (prod)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# REQUIRED — Clerk secret key. Server-side only. Never expose to the browser.
# Format: sk_test_... (dev) or sk_live_... (prod)
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# REQUIRED — Webhook signing secret from Clerk → Webhooks → Endpoints → your endpoint.
# Used to verify incoming webhook signatures in POST /api/webhooks/clerk.
# Format: whsec_...
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# OPTIONAL — Clerk sign-in / sign-up redirect paths. Defaults below match the
# routes documented in docs/01-architecture-overview.md.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard


# =============================================================================
# DATABASE (Railway PostgreSQL + Prisma)
# =============================================================================
# Create a PostgreSQL service in Railway, then copy the connection string from
# the Railway dashboard → your database → Connect → Postgres Connection URL.

# REQUIRED — Primary Prisma connection string (used by queries at runtime).
# Railway provides pgBouncer / connection pooling by default.
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:REPLACE_ME@containers-us-west-1.railway.app:5432/railway

# OPTIONAL — Direct (non-pooled) connection, used by Prisma Migrate and for
# long-lived admin operations. Railway exposes this as a separate URL when
# pooling is enabled. If you're not using pooling, set this equal to DATABASE_URL.
DIRECT_URL=postgresql://postgres:REPLACE_ME@containers-us-west-1.railway.app:5432/railway


# =============================================================================
# RATE LIMITING (optional — see docs/11-api-contracts.md)
# =============================================================================
# The API contract specifies per-user rate limits. Using Upstash Redis is the
# simplest way to implement them in a Next.js edge-compatible way. Skip these
# variables if you're shipping without rate limiting (acceptable for v1 if the
# app is invite-only or single-tenant).

# OPTIONAL — Upstash Redis REST URL and token. Get from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# =============================================================================
# OBSERVABILITY (optional — deferred to post-v1 if not decided yet)
# =============================================================================

# OPTIONAL — Sentry DSN for client + server error reporting.
# Format: https://xxxxxxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_DSN=

# OPTIONAL — Sentry environment tag. Should match NODE_ENV usually.
SENTRY_ENVIRONMENT=development


# =============================================================================
# FEATURE FLAGS (optional)
# =============================================================================

# OPTIONAL — Enable the cloud-sync entry point. When false, the app runs in
# local-only mode (persists to localStorage, no Clerk, no DB writes). Used for
# development and for privacy-sensitive preview deploys.
# One of: true | false. Default: true
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=true

# OPTIONAL — Enable import-from-HTML flow (paste the original HTML dashboard's
# CONFIG JSON to seed a fresh account). One of: true | false. Default: true
NEXT_PUBLIC_ENABLE_HTML_IMPORT=true
