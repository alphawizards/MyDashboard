# Next.js build output
.next/
out/

# Dependencies
node_modules/

# Environment files — never commit
.env.local
.env*.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript incremental build
*.tsbuildinfo

# Prisma generated client
# (committed for reproducible builds — remove if you prefer to generate on deploy)
# node_modules/.prisma/

# size-limit
.size-limit/

# PII defence-in-depth — parent .gitignore covers these too, but guard against
# app-next being extracted as a standalone repo in future.
../reference/
../docs/10-test-fixtures.md
